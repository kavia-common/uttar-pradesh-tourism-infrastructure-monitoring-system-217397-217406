# Example environment variables for project_backend
# Copy this file to your environment and set appropriately (do not commit .env)

# Server
SERVER_PORT=8080
MANAGEMENT_PORT=8080

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/upstdc
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT
# Use a strong BASE64 secret in production, e.g.,: openssl rand -base64 32
APP_JWT_SECRET=dev-secret-change-me
APP_JWT_EXPIRATION_MS=3600000
APP_JWT_REFRESH_EXPIRATION_MS=1209600000

# Uploads
UPLOADS_DIR=./uploads

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Geo (optional)
GEO_REVERSE_ENABLED=false
GEO_API_KEY=

# Mail (optional for NotificationQueue actual delivery)
# If not set, notifications will be logged and marked SENT (no external calls).
spring.mail.host=
spring.mail.port=587
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Notification queue scheduler and retry tuning
NOTIFY_SCHEDULER_DELAY_MS=60000
NOTIFY_MAX_RETRIES=3
NOTIFY_BATCH_SIZE=25
