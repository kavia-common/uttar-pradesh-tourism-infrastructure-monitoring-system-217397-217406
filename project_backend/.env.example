# Application port
SERVER_PORT=8080

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/upstdc
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# JWT (use strong secrets in production)
# 256-bit base64 e.g. `openssl rand -base64 32`
APP_JWT_SECRET=dev-secret-change-me
APP_JWT_EXPIRATION_MS=3600000
APP_JWT_REFRESH_EXPIRATION_MS=1209600000

# File uploads
UPLOADS_DIR=./uploads
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=50MB
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Geo reverse geocoding (optional)
GEO_REVERSE_ENABLED=false
GEO_API_KEY=

# Mail delivery (optional)
# If not configured, NotificationQueueService will log as SENT (simulation mode).
# For real email delivery configure Spring Mail properties below.
spring.mail.host=
spring.mail.port=587
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
# Alternative boolean to indicate enablement if mapping spring.mail.host is not used by environment tooling
MAIL_ENABLED=

# Notification processor
NOTIFY_SCHEDULER_DELAY_MS=60000   # run every 60s
NOTIFY_MAX_RETRIES=3              # max retry attempts before marking FAILED
NOTIFY_BATCH_SIZE=25              # max items per scheduler tick
